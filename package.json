{
  "name": "vectorscope-ai",
  "version": "1.0.0",
  "description": "VectorScopeAI - AI Sales template",
  "main": "index.js",
  "scripts": {
    "start:tailwind": "cross-env NODE_ENV=development tailwindcss --postcss -i css/tailwind.css -o css/tailwind-build.css -w",
    "build:tailwind": "cross-env NODE_ENV=production tailwindcss --postcss -i css/tailwind.css -o css/tailwind-build.css --minify",
    "start": "npm run start:tailwind",
    "build": "npm run build:tailwind"
  },
  "keywords": ["landing", "tailwind", "ai-sales"],
  "private": true,
  "devDependencies": {
    "cross-env": "^7.0.3",
    "tailwindcss": "^3.4.1"
  },
  "dependencies": {
    "postcss": "^8.4.33",
    "postcss-simple-vars": "^7.0.1"
  }
}
